find_package(PkgConfig REQUIRED)
pkg_check_modules(GLIB REQUIRED IMPORTED_TARGET glib-2.0>=2.66)
pkg_check_modules(MAD REQUIRED IMPORTED_TARGET mad)
pkg_check_modules(FAAD REQUIRED IMPORTED_TARGET faad2)
pkg_check_modules(VORBIS REQUIRED IMPORTED_TARGET vorbis)
pkg_check_modules(OGG REQUIRED IMPORTED_TARGET ogg)
find_package(OpenSSL 3.0 REQUIRED)
find_package(Iconv REQUIRED)

file(STRINGS "${CMAKE_SOURCE_DIR}/VERSION" SR_RELEASE_VERSION LIMIT_COUNT 1)
configure_file(cmake/modern_config.h.in sr_config.h)
include_directories(lib "${CMAKE_CURRENT_BINARY_DIR}" ${GLIB_INCLUDE_DIRS})
add_compile_definitions(WIN32 _WIN32_WINNT=0x0601 SR_MODERN_WINDOWS HAVE_OPENSSL)
add_compile_definitions(SRVERSION="${SR_RELEASE_VERSION}")
add_subdirectory(lib)
target_link_libraries(streamripper1 PUBLIC PkgConfig::GLIB PkgConfig::MAD PkgConfig::FAAD PkgConfig::VORBIS PkgConfig::OGG Iconv::Iconv OpenSSL::SSL OpenSSL::Crypto ws2_32 crypt32 shlwapi)
add_executable(streamripper console/streamripper.c)
target_compile_features(streamripper PRIVATE c_std_99)
target_compile_options(streamripper PRIVATE -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare)
target_link_libraries(streamripper PRIVATE streamripper1)
get_filename_component(SR_RUNTIME_DIR "${CMAKE_C_COMPILER}" DIRECTORY)
add_custom_command(TARGET streamripper POST_BUILD
    COMMAND "${CMAKE_COMMAND}"
        "-DSR_EXECUTABLE=$<TARGET_FILE:streamripper>"
        "-DSR_RUNTIME_DIR=${SR_RUNTIME_DIR}"
        "-DSR_OBJDUMP=${CMAKE_OBJDUMP}"
        -P "${CMAKE_SOURCE_DIR}/cmake/CopyWindowsRuntime.cmake"
    VERBATIM)
set_property(TARGET streamripper APPEND PROPERTY LINK_DEPENDS
    "${CMAKE_SOURCE_DIR}/cmake/CopyWindowsRuntime.cmake")
install(TARGETS streamripper RUNTIME DESTINATION .)
include(CTest)
if(BUILD_TESTING)
    add_executable(stream_buffer_regression testing/stream_buffer_lifecycle.c)
    target_link_libraries(stream_buffer_regression PRIVATE streamripper1)
    add_test(NAME stream_buffer_regression COMMAND stream_buffer_regression)
    add_executable(http_security_regression testing/http_security.c)
    target_link_libraries(http_security_regression PRIVATE streamripper1)
    add_test(NAME http_security_regression COMMAND http_security_regression)
    add_executable(aac_silence_regression testing/aac_silence.c)
    target_link_libraries(aac_silence_regression PRIVATE streamripper1)
    add_executable(console_output_regression testing/console_output.c)
    target_link_libraries(console_output_regression PRIVATE streamripper1)
    add_executable(preallocation_regression testing/file_preallocation.c lib/file_preallocation.c)
    target_compile_features(preallocation_regression PRIVATE c_std_99)
    target_compile_options(preallocation_regression PRIVATE -Wall -Wextra)
    add_test(NAME preallocation_regression COMMAND preallocation_regression)
    add_executable(core_regression testing/core_regression.c)
    target_link_libraries(core_regression PRIVATE streamripper1 psapi)
    add_test(NAME core_regression COMMAND core_regression)
endif()
